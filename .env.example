# User ID (run `id` on the host to find yours)
PUID=1000
PGID=1000

# Path to your NAS storage on the host machine
NAS_ROOT=/home/kimzam30/nas_data

# Media library root, mounted into Jellyfin at /media
MEDIA_ROOT=/home/kimzam30/media

# Speedtest Tracker config directory on the host
SPEEDTEST_CONFIG=./config/speedtest

# Speedtest Tracker application key.
# Generate a real one — do not ship the example value:
#   echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=base64:generate_your_own_key_here

# Network Info
TAILSCALE_IP=100.x.x.x

# Pi-hole admin password
PIHOLE_PASSWORD=your_password_here
